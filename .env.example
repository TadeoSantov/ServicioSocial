# ── AI Provider Keys ─────────────────────────────────────────────────────────
# At minimum you need GROQ_API_KEY (for Whisper) and one LLM key

# Groq — Required for Whisper transcription
GROQ_API_KEY=gsk_your_groq_api_key_here

# Mistral — Primary LLM provider
MISTRAL_API_KEY=your_mistral_api_key_here

# Google Gemini — Backup LLM provider (optional)
GOOGLE_API_KEY=your_google_api_key_here

# Azure OpenAI — Enterprise alternative (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_WHISPER_DEPLOYMENT=whisper
AZURE_API_VERSION=2024-12-01-preview

# ── Backend Config ───────────────────────────────────────────────────────────
PORT=8080
ENV=development
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
